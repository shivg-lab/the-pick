# Public template: keep API key values blank in this file.
# Put real credentials in the project-root .env, which is excluded from Git.
# API keys are server-only; never prefix them with NEXT_PUBLIC_.
APP_MODE=demo
APP_NAME=The Pick
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
LLM_TEMPERATURE=0
AGENT_MAX_STEPS=4
AGENT_MAX_TOOL_CALLS=10
LLM_TIMEOUT_SECONDS=90
PROVIDER_TIMEOUT_SECONDS=12
EVENT_PROVIDER=demo
SPORTS_PROVIDER=demo
# Open-Meteo free prototype forecast; no key required. Use disabled for offline operation.
WEATHER_PROVIDER=open_meteo
TICKETMASTER_API_KEY=
SPORTRADAR_API_KEY=
# Set the exact licensed feed path, e.g. nfl/official/trial/v7/en/games/2026/REG/schedule.json
SPORTRADAR_FEED_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=The Pick
